@model wt_lab4_4mvc_leshkevich.Models.Car

<div class="container py-4">
    <div class="card shadow-sm rounded-4 p-4 col-md-8 mx-auto">
        <h2 class="mb-4">Добавление нового автомобиля</h2>

        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="BrandModel" class="form-label">Марка и модель</label>
                <input asp-for="BrandModel" class="form-control" placeholder="Например: Mercedes-Benz W211" required />
                <span asp-validation-for="BrandModel" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label">Категория (класс)</label>
                <input asp-for="Category" class="form-control" placeholder="Например: Седан" required />
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PricePerDay" class="form-label">Цена за сутки (руб.)</label>
                <input asp-for="PricePerDay" type="number" step="0.01" class="form-control" required />
                <span asp-validation-for="PricePerDay" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsAvailable" class="form-check-input" type="checkbox" checked />
                <label asp-for="IsAvailable" class="form-check-label">Доступен для аренды</label>
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
            </div>
        </form>
    </div>
</div>