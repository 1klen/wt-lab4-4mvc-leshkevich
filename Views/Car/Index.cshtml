@model List<wt_lab4_4mvc_leshkevich.Models.Car>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Каталог автомобилей</h1>
            <p class="text-muted">Система проката автомобилей</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">Добавить автомобиль</a>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var car in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">ID: @car.Id</span>
                        <h5 class="card-title">@car.BrandModel</h5>
                        <p class="text-muted mb-1">Класс: @car.Category</p>
                        <p class="fs-4 fw-bold text-primary">@car.PricePerDay руб./сутки</p>
                        <p>
                            @if (car.IsAvailable)
                            {
                                <span class="badge bg-success">Доступен</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Снят с аренды</span>
                            }
                        </p>
                        
                        <div class="d-flex gap-2 mt-3">
                            <a asp-action="Details" asp-route-id="@car.Id" class="btn btn-outline-primary btn-sm">Подробнее</a>
                            <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-outline-secondary btn-sm">Редактировать</a>
                            <a asp-action="Delete" asp-route-id="@car.Id" class="btn btn-outline-danger btn-sm">Удалить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>