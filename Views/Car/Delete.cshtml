@model wt_lab4_4mvc_leshkevich.Models.Car

<div class="container py-4">
    <div class="card shadow-sm rounded-4 p-4 col-md-8 mx-auto border-danger">
        <h2 class="mb-3 text-danger">Удаление автомобиля</h2>
        <p class="text-muted">Вы уверены, что хотите удалить этот автомобиль из проката?</p>
        <hr />
        
        <p><strong>Марка и модель:</strong> @Model.BrandModel</p>
        <p><strong>Категория:</strong> @Model.Category</p>
        <p><strong>Цена за сутки:</strong> @Model.PricePerDay руб.</p>
        
        <form asp-action="Delete" method="post" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-danger">Удалить</button>
                <a asp-action="Index" class="btn btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>